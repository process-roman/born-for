  "endings": [
    {
      "id": "ux_end_pivot",
      "name": "Found a Different Path",
      "when": {
        "flagsAll": [
          "pivoted"
        ]
      },
      "roleOverride": "Took design somewhere new",
      "text": "Design opened a door you didn't expect. You walked through it, and you still see the world like a designer. You just use it differently now."
    },
    {
      "id": "ux_end_studio",
      "name": "Started Your Own Studio",
      "when": {
        "flagsAll": [
          "studio"
        ],
        "meterMin": {
          "joy": 40
        }
      },
      "text": "Your name is on the door. Some months are lean, some are great, and every decision is yours."
    },
    {
      "id": "ux_end_rebuilt",
      "name": "Burned Out, Then Rebuilt",
      "when": {
        "flagsAll": [
          "burned_out"
        ]
      },
      "text": "Somewhere in your twenties it got to be too much. You stepped back, learned your limits and came back on your own terms. Most people learn that much later."
    },
    {
      "id": "ux_end_thriving",
      "name": "Thriving",
      "when": {
        "meterMin": {
          "mastery": 55,
          "joy": 65
        }
      },
      "text": "You're good at this, and you still love it. People use things you made every day without knowing your name. You know, though."
    },
    {
      "id": "ux_end_steady",
      "name": "Steady",
      "when": {},
      "text": "A solid design career: good work, good people, a life that fits. Not every life needs fireworks."
    }
  ],
  "events": [
    {
      "id": "ux_opener",
      "kind": "opener",
      "stages": [
        "start"
      ],
      "icon": "compass",
      "title": "Where It Starts",
      "text": "You want to design the apps people use every day. First question: how do you learn?",
      "choices": [
        {
          "id": "degree",
          "label": "Study design at university",
          "hint": "4 years · solid foundation · student debt",
          "result": {
            "text": "Four years of critiques, all-nighters and one great professor. You graduate knowing why things work, not just how.",
            "effects": {
              "money": -15,
              "mastery": 20,
              "energy": -5,
              "set": [
                "route_degree"
              ]
            }
          }
        },
        {
          "id": "bootcamp",
          "label": "Do an intensive bootcamp",
          "hint": "6 months · fast · tougher job hunt",
          "result": {
            "text": "Six months of twelve-hour days and one shiny portfolio. You're exhausted, and ready-ish.",
            "effects": {
              "money": -10,
              "mastery": 12,
              "energy": -15,
              "set": [
                "route_bootcamp"
              ]
            }
          }
        },
        {
          "id": "self",
          "label": "Teach yourself",
          "hint": "Free · flexible · all on you",
          "check": {
            "attribute": "persistence",
            "difficulty": 60
          },
          "success": {
            "text": "Courses, videos and redesigns of every app on your phone. It works.",
            "effects": {
              "mastery": 15,
              "joy": 5,
              "set": [
                "route_self"
              ],
              "highlight": "Taught yourself design from scratch"
            }
          },
          "fail": {
            "text": "Motivation comes and goes. You learn a lot, just slower than you hoped.",
            "effects": {
              "mastery": 8,
              "joy": -5,
              "set": [
                "route_self"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "ux_first_critique",
      "kind": "career",
      "stages": [
        "training"
      ],
      "icon": "chat-circle",
      "title": "The First Critique",
      "text": "Your first project goes up on the wall. Someone calls it \"safe.\" Everyone looks at you.",
      "choices": [
        {
          "id": "defend",
          "label": "Explain your choices",
          "check": {
            "attribute": "communication",
            "difficulty": 60
          },
          "success": {
            "text": "You walk them through your thinking. The room nods. \"Safe\" turns out to mean \"clear,\" and clear is good.",
            "effects": {
              "mastery": 8,
              "joy": 5
            }
          },
          "fail": {
            "text": "You get defensive and it shows. Rough afternoon, useful lesson.",
            "effects": {
              "mastery": 5,
              "joy": -5
            }
          }
        },
        {
          "id": "listen",
          "label": "Ask what they'd change",
          "result": {
            "text": "You take notes, swallow your pride and redo it. Version two is much better.",
            "effects": {
              "mastery": 10
            }
          }
        },
        {
          "id": "bold",
          "label": "Start over with something bold",
          "check": {
            "attribute": "creativity",
            "difficulty": 65
          },
          "success": {
            "text": "The bold version is the best thing you've made so far.",
            "effects": {
              "mastery": 12,
              "joy": 10,
              "highlight": "Found your bold style early"
            }
          },
          "fail": {
            "text": "Bold, yes. Usable, no. Back to the middle ground.",
            "effects": {
              "mastery": 3,
              "energy": -10
            }
          }
        }
      ]
    },
    {
      "id": "ux_bakery",
      "kind": "career",
      "stages": [
        "training"
      ],
      "icon": "storefront",
      "title": "The Bakery Website",
      "text": "A friend runs a tiny bakery. Her website has six fonts and a spinning cupcake. She asks if you can help.",
      "choices": [
        {
          "id": "free",
          "label": "Redesign it for free",
          "hint": "A real project for your portfolio",
          "result": {
            "text": "Your first real client. She cries (the good kind). You have a real case study.",
            "effects": {
              "mastery": 6,
              "joy": 10,
              "energy": -5,
              "set": [
                "has_portfolio"
              ],
              "highlight": "Redesigned your first real website"
            }
          }
        },
        {
          "id": "fee",
          "label": "Charge a small fee",
          "check": {
            "attribute": "communication",
            "difficulty": 55
          },
          "success": {
            "text": "She says yes. Your first design paycheck buys one very nice dinner.",
            "effects": {
              "money": 8,
              "mastery": 6,
              "joy": 5,
              "set": [
                "has_portfolio"
              ]
            }
          },
          "fail": {
            "text": "Awkward. She finds someone cheaper online. Pricing, it turns out, is a skill too.",
            "effects": {
              "joy": -5
            }
          }
        },
        {
          "id": "busy",
          "label": "Say you're too busy",
          "result": {
            "text": "You rest instead. Fair, but your portfolio stays thin.",
            "effects": {
              "energy": 10,
              "joy": -5
            }
          }
        }
      ]
    },
    {
